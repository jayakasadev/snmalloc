# Bazel build file for the `snmalloc-rs` crate.
#
# Bazel has no equivalent of `cargo --features`, so each useful Cargo feature
# combination is a separate `rust_library` target. Depend on the one that
# matches your needs.
#
# Tests under `tests/` build against `:snmalloc_rs_profiling` if they need the
# `profiling` feature, and against `:snmalloc_rs` otherwise. Benches are not
# exposed: the Criterion harness needs dev-deps this build file does not model.

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load(":defs.bzl", "snmalloc_rs_profiling_library")

package(default_visibility = ["//visibility:public"])

_CRATE_ROOT = "src/lib.rs"

_CRATE_SRCS = glob(
    ["src/**/*.rs"],
    allow_empty = False,
)

# Exported so that `snmalloc_rs_profiling_library` (defs.bzl) can reference
# this repo's sources through a fully qualified `Label(...)`. A bare glob()
# inside the macro would resolve against the caller's package instead.
filegroup(
    name = "lib_srcs",
    srcs = _CRATE_SRCS,
)

# Default (no-profiling) build.
rust_library(
    name = "snmalloc_rs",
    srcs = _CRATE_SRCS,
    crate_root = _CRATE_ROOT,
    edition = "2021",
    deps = [
        "//snmalloc-rs/snmalloc-sys:snmalloc_sys",
    ],
)

# Profiling build (Cargo feature `profiling`), for this repo's own tests and
# CI. It binds this repo's `@crates`, which downstream consumers cannot see
# (see MODULE.bazel); they call `snmalloc_rs_profiling_library` from defs.bzl
# with their own crate universe instead.
#
# Frames are emitted as 16-hex-digit addresses. For resolved names, see
# `:snmalloc_rs_profiling_symbolicated` below.
snmalloc_rs_profiling_library(
    name = "snmalloc_rs_profiling",
    crate_features = ["profiling"],
    flate2_dep = "@crates//:flate2",
)

rust_library(
    name = "snmalloc_rs_profile_refill_secondary",
    srcs = _CRATE_SRCS,
    aliases = {
        "//snmalloc-rs/snmalloc-sys:snmalloc_sys_profile_refill_secondary": "snmalloc_sys",
    },
    crate_features = [
        "profiling",
        "profile-refill-sampling",
        "profile-secondary-storage",
        "profile-refill-secondary",
    ],
    crate_name = "snmalloc_rs",
    crate_root = _CRATE_ROOT,
    edition = "2021",
    deps = [
        "//snmalloc-rs/snmalloc-sys:snmalloc_sys_profile_refill_secondary",
        "@crates//:flate2",
    ],
)

# Profiling + symbolicate build (Cargo features `profiling`, `symbolicate`).
# Same `@crates` caveat as `:snmalloc_rs_profiling` above. Same C archive too,
# since the symbolicator is Rust-side only, plus `backtrace` so
# `HeapProfile::write_flamegraph` and `write_pprof_gz` resolve frame addresses
# to function/file/line at dump time.
#
# Prefer this over `:snmalloc_rs_profiling` when the binary serves pprof to a
# UI that cannot symbolicate (Grafana Pyroscope, Polar Signals,
# `go tool pprof -http=:8080 -`), or when operators would otherwise run
# `atos -o <bin> -l <load_base> <addr>` on every frame.
#
# Cost: `backtrace` pulls in `addr2line`, `gimli`, and `object`, and parses
# the binary's debug info on first use. Near zero if the binary already links
# those crates (panic backtraces, tracing-error, and so on).
snmalloc_rs_profiling_library(
    name = "snmalloc_rs_profiling_symbolicated",
    crate_features = [
        "profiling",
        "symbolicate",
    ],
    backtrace_dep = "@crates//:backtrace",
    flate2_dep = "@crates//:flate2",
)

# Profile-enabled build without the `profiling` Cargo feature, and so without
# flate2. Use this from downstream Bazel modules, which cannot resolve
# `@crates//:flate2` and therefore cannot use `:snmalloc_rs_profiling`.
#
# Same Rust source as `:snmalloc_rs`, but bound to the
# `:snmalloc_sys_profiling` C archive (SNMALLOC_PROFILE=ON) so the
# `sn_rust_profile_*` externs resolve. `snapshot()`, `write_flamegraph()`, and
# `init_profiling_from_env()` are available because the wrapper crate defines
# them unconditionally. `write_pprof_gz` is not: it needs the Cargo feature.
rust_library(
    name = "snmalloc_rs_profile_compat",
    srcs = _CRATE_SRCS,
    aliases = {
        "//snmalloc-rs/snmalloc-sys:snmalloc_sys_profiling": "snmalloc_sys",
    },
    crate_name = "snmalloc_rs",
    crate_root = _CRATE_ROOT,
    edition = "2021",
    deps = [
        "//snmalloc-rs/snmalloc-sys:snmalloc_sys_profiling",
    ],
)

# ---------------------------------------------------------------------------
# Tests, split by whether they need the `profiling` feature.
# ---------------------------------------------------------------------------

# memory_stats only needs `sn_rust_statistics`, not profiling.
rust_test(
    name = "memory_stats_test",
    srcs = ["tests/memory_stats.rs"],
    edition = "2021",
    deps = [":snmalloc_rs"],
)

# Profiling integration tests. These link against `:snmalloc_rs_profiling`, so
# the `cfg(feature = "profiling")` blocks are live and the C archive has
# `SNMALLOC_PROFILE=ON`.
#
# Two tests are deliberately absent: profile_viewer_roundtrip.rs and
# profile_pprof_roundtrip.rs need dev-deps (`inferno`) or host tooling
# (`go tool pprof`), so they run under Cargo only.
#
# profile_symbolize.rs is declared separately below, against
# `:snmalloc_rs_profiling_symbolicated`.
[
    rust_test(
        name = "{}_test".format(name),
        srcs = ["tests/{}.rs".format(name)],
        crate_features = ["profiling"],
        edition = "2021",
        deps = [
            ":snmalloc_rs_profiling",
            "//snmalloc-rs/snmalloc-sys:snmalloc_sys_profiling",
            "@crates//:flate2",
        ],
    )
    for name in [
        "profile_snapshot",
        "profile_streaming",
        "profile_lifetime_histogram",
        "profile_accuracy",
        "profile_pprof",
        "profile_pprof_gz",
        "profile_realloc",
        "profile_runtime_config",
    ]
]

# Symbolicate integration test. Built against
# `:snmalloc_rs_profiling_symbolicated` so the
# `#![cfg(feature = "symbolicate")]` body is live and `backtrace` is linked.
rust_test(
    name = "profile_symbolize_test",
    srcs = ["tests/profile_symbolize.rs"],
    crate_features = [
        "profiling",
        "symbolicate",
    ],
    edition = "2021",
    deps = [
        ":snmalloc_rs_profiling_symbolicated",
        "//snmalloc-rs/snmalloc-sys:snmalloc_sys_profiling",
        "@crates//:backtrace",
        "@crates//:flate2",
    ],
)
